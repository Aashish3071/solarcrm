// Phase 0 foundation schema: identity, projects with stage tracking, audit and
// configuration. Module-specific tables (payments, loan, DISCOM, material,
// documents, automation, AI) are added in their phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES
  SALES_PARTNER
  SITE_SUPERVISOR
  ACCOUNTS
  OFFICE_EXECUTIVE
  LOAN_OFFICER
  DISCOM_OFFICER
  PROJECT_ENGINEER
  STORE_MANAGER
  CUSTOMER
  ADMIN
}

enum LeadSource {
  DIRECT
  SALES_PARTNER
}

enum PartnerType {
  LEAD_ONLY
  FULL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  createdAt    DateTime @default(now())
  /// Automation (FR-A01/A02): availability, capacity and territory for routing.
  awayUntil      DateTime?
  maxOpen        Int?
  territories    String[]
  lastAssignedAt DateTime?

  ownedProjects Project[]           @relation("ProjectOwner")
  assignments   ProjectAssignment[]
}

/// FR-041: Lead-only Partner and Full Sales Partner.
model Partner {
  id        String      @id @default(cuid())
  name      String
  type      PartnerType
  createdAt DateTime    @default(now())
  users     User[]
  projects  Project[]
}

/// A lead becomes a project record from stage 1; the same record is carried
/// through all 23 stages (FRD §5).
model Project {
  id               String     @id @default(cuid())
  seq              Int        @unique @default(autoincrement())
  customerName     String
  phone            String
  email            String?
  address          String
  /// FR-002 fields below are captured at stage 2 (Requirement Captured).
  requiredKw       Decimal?   @db.Decimal(8, 2)
  loanRequired     Boolean    @default(false)
  loanAmount       Decimal?   @db.Decimal(12, 2)
  projectType      String?
  packageName      String?
  leadSource       LeadSource
  partnerId        String?
  partner          Partner?   @relation(fields: [partnerId], references: [id])
  ownerId          String
  owner            User       @relation("ProjectOwner", fields: [ownerId], references: [id])
  completedStages  String[]
  skippedStages    String[]
  supervisorAssignedAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  assignments ProjectAssignment[]
  events      StageEvent[]
  siteVisit   SiteVisit?
  terms       SalesTerms?
  payments    Payment[]
  documents   Document[]
  gov         GovRegistration?
  loan        LoanApplication?
  discom      DiscomApplication?
  plan        ProjectPlan?
  install     Installation?
  schedule    PaymentScheduleItem[]
  incentive   IncentiveResult?
  tasks       Task[]
  slaTimers   SlaTimer[]

  @@index([ownerId])
  @@index([partnerId])
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role       Role
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  assignedBy String

  @@unique([projectId, role])
  @@index([userId])
}

enum StageAction {
  COMPLETED
  REOPENED
}

model StageEvent {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     String
  action    StageAction
  actorId   String?
  actorRole String
  data      Json
  at        DateTime    @default(now())

  @@index([projectId, at])
}

/// Who did what, when (Booklet §10). Append-only.
model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String?
  meta     Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

/// FR-043: business rules as data (discount ceiling, percentages, durations).
model ConfigParam {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// FR-005 / FR-006: visit schedule and site assessment.
model SiteVisit {
  projectId        String    @id
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime?
  lateReason       String?
  completedAt      DateTime?
  actualKw         Decimal?  @db.Decimal(8, 2)
  feasible         Boolean?
  suggestedPackage String?
  deviations       String?
  siteNotes        String?
}

/// FR-007 / FR-008 / FR-039: final commercial terms and customer confirmation.
model SalesTerms {
  projectId     String    @id
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageName   String
  finalCost     Decimal   @db.Decimal(12, 2)
  discountPct   Decimal   @db.Decimal(5, 2)
  paymentTerms  String
  finalizedById String
  finalizedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  confirmationNote String?
}

enum PaymentKind {
  ADVANCE
  LOAN_INSTALMENT_1
  LOAN_INSTALMENT_2
  COLLECTION
}

enum PaymentStatus {
  LOGGED
  APPROVED
  REJECTED
}

/// FR-009 / FR-010 / FR-036–038: Sales logs, Accounts verifies against the bank statement.
model Payment {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            PaymentKind
  amount          Decimal       @db.Decimal(12, 2)
  mode            String
  utr             String
  status          PaymentStatus @default(LOGGED)
  loggedById      String
  loggedAt        DateTime      @default(now())
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?

  @@index([status, loggedAt])
  @@index([projectId])
  @@index([utr])
}

enum DocumentType {
  SITE_PHOTO
  DESIGN
  INSTALLATION_PLAN
  INSTALLATION_PHOTO
  COMPLETION_CERTIFICATE
  TRAINING_CERTIFICATE
  GOV_DOCUMENT
  LOAN_DOCUMENT
  DISCOM_DOCUMENT
  OTHER
}

/// FRD §7 documents. Binary lives in object storage keyed by project and stage (Booklet §6.6).
model Document {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         DocumentType
  stage        String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String       @unique
  uploadedById String
  uploadedAt   DateTime     @default(now())

  @@index([projectId, type])
}

/// FR-012: government portal registration (manual status until an API exists).
model GovRegistration {
  projectId        String    @id
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status           String
  registrationNo   String?
  registrationDate DateTime?
  notes            String?
  updatedAt        DateTime  @updatedAt
  updatedById      String
}

/// FR-013, FR-016 – FR-019: loan application and customer/bank split.
model LoanApplication {
  projectId           String    @id
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bank                String
  status              String
  requestedAmount     Decimal   @db.Decimal(12, 2)
  approvedAmount      Decimal?  @db.Decimal(12, 2)
  clientReconfirmedAt DateTime?
  reconfirmedById     String?
  notes               String?
  updatedAt           DateTime  @updatedAt
  updatedById         String
}

/// FR-021, FR-022, FR-034: DISCOM application, meter and final approval.
model DiscomApplication {
  projectId         String    @id
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationNo     String
  status            String
  meterNumber       String?
  meterInstalledAt  DateTime?
  finalApprovalDate DateTime?
  notes             String?
  updatedAt         DateTime  @updatedAt
  updatedById       String
}

/// FR-014 site revisit, FR-015/025/026 schedule, FR-027–030 material and delay tracking.
model ProjectPlan {
  projectId        String    @id
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisitAt        DateTime?
  revisitNotes     String?
  plannedStart     DateTime?
  expectedEnd      DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  rescheduleCount  Int       @default(0)
  delayReason      String?
  materialReadyAt  DateTime?
  readyRemark      String?
  dispatchedAt     DateTime?
  receivedAt       DateTime?
  receivedRemark   String?
}

/// FR-031 – FR-033, FR-035: execution, training and completion.
model Installation {
  projectId           String    @id
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedAt           DateTime?
  endedAt             DateTime?
  trainingAssigneeId  String?
  trainingCompletedAt DateTime?
  completedAt         DateTime?
}

enum Payer {
  CUSTOMER
  BANK
}

/// FR-007 / FR-036: agreed payment terms as dated milestones; basis for overdue receivables.
model PaymentScheduleItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  label     String
  payer     Payer
  amount    Decimal  @db.Decimal(12, 2)
  dueDate   DateTime

  @@index([projectId])
  @@index([dueDate])
}

/// FR-039 – FR-043: incentive and partner commission, computed at stage 23.
model IncentiveResult {
  projectId               String   @id
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesUserId             String
  partnerId               String?
  orderValue              Decimal  @db.Decimal(12, 2)
  discountPct             Decimal  @db.Decimal(5, 2)
  incentivePct            Decimal  @db.Decimal(7, 4)
  incentiveAmount         Decimal  @db.Decimal(12, 2)
  partnerCommissionPct    Decimal  @db.Decimal(7, 4)
  partnerCommissionAmount Decimal  @db.Decimal(12, 2)
  /// Rules used, so a later config change never silently rewrites history.
  rules                   Json
  provisional             Boolean  @default(true)
  calculatedAt            DateTime @default(now())
}

enum RuleKind {
  ROUTING
  ASSIGNMENT
  FOLLOW_UP
  SLA
}

enum RuleMode {
  SUGGEST
  AUTO
}

/// Addendum FR-A05: automation rules as data; edits bump the version and are audited.
model AutomationRule {
  id        String   @id @default(cuid())
  name      String
  kind      RuleKind
  /// Stage whose opening triggers the rule, or LEAD_CREATED for routing.
  trigger   String
  config    Json
  mode      RuleMode @default(SUGGEST)
  active    Boolean  @default(true)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  runs      AutomationRun[]

  @@index([kind, trigger, active])
}

model AutomationRun {
  id        String          @id @default(cuid())
  ruleId    String?
  rule      AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  projectId String?
  outcome   String
  detail    Json
  at        DateTime        @default(now())

  @@index([at])
}

enum TaskKind {
  FOLLOW_UP
  ASSIGNMENT
  SLA_ESCALATION
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// My Work items. Owned by a person, or by a role queue when ownerId is null.
model Task {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         TaskKind
  title        String
  stage        String?
  ownerId      String?
  ownerRole    String
  dueAt        DateTime
  status       TaskStatus @default(OPEN)
  /// Suggested assignee for ASSIGNMENT tasks.
  suggestion   Json?
  dedupeKey    String     @unique
  createdAt    DateTime   @default(now())
  completedAt  DateTime?
  completedById String?

  @@index([ownerId, status, dueAt])
  @@index([ownerRole, status, dueAt])
}

/// FR-A04: one live SLA clock per project and stage.
model SlaTimer {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage        String
  ruleId       String?
  targetHours  Float
  warnPct      Int
  escalateTo   String
  startedAt    DateTime
  pausedAt     DateTime?
  pausedMs     Int       @default(0)
  warnedAt     DateTime?
  breachedAt   DateTime?
  resolvedAt   DateTime?

  @@unique([projectId, stage])
  @@index([resolvedAt])
}
